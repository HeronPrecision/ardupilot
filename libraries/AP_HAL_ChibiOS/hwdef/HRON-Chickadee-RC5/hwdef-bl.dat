# hw definition file for processing by chibios_hwdef.py
# for HRON-Chickadee-RC4 hardware.

# MCU class and specific type
MCU STM32H7xx STM32H743xx

# board ID for firmware load
APJ_BOARD_ID AP_HW_HRON_Chickadee_RC4

# crystal frequency, setup to use external oscillator
OSCILLATOR_HZ 25000000

FLASH_SIZE_KB 2048

# bootloader starts at zero offset
FLASH_RESERVE_START_KB 0

# the location where the bootloader will put the firmware
FLASH_BOOTLOADER_LOAD_KB 128

# Reduce bootloader timeout to 2 seconds for faster boot
define HAL_BOOTLOADER_TIMEOUT 2

# order of UARTs (and USB)
SERIAL_ORDER OTG1

# USB
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# Chip select pins
PB2 GYRO1_CS CS
PB15 GYRO2_CS CS
PE4 GYRO3_CS CS
PE3 BARO_CS CS

# LEDs - Keep LED_BOOTLOADER for proper bootloader operation
PB0 LED_BOOTLOADER OUTPUT HIGH  # LED on PB0 for bootloader
define HAL_LED_ON 0  # Enable LEDs

# SWD Debugging
PA13 JTMS-SWDIO SWD  # SWD data line
PA14 JTCK-SWCLK SWD  # SWD clock line
